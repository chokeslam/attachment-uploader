{
    "name": "lyrasoft/attachment",
    "description": "LYRASOFT attachment package",
    "type": "windwalker-package",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Lyrasoft\\Attachment\\": "src/"
        }
    },
    "authors": [
        {
            "name": "chokeslam",
            "email": "chokeslam5608@gmail.com"
        }
    ],
    "minimum-stability": "beta",
    "require": {
        "php": ">=8.4.6",
        "lyrasoft/luna": "^2.2"
    },
    "extra": {
        "windwalker":{
            "packages": [
                "Lyrasoft\\Attachment\\AttachmentPackage"
            ],
            "assets": {
                "vendors": {
                    "@lyrasoft/attachment": "portal:./vendor/lyrasoft/attachment/assets"
                }
            },
            "modules": [
                "src/Module"
            ]
        }
    }
